# Copy to .env.local (web) / set in Vercel project settings.

# Postgres (Neon, Supabase, Vercel Postgres…)
DATABASE_URL="postgresql://user:pass@host/db"

# Claude API
ANTHROPIC_API_KEY="sk-ant-…"
# Optional model overrides (default claude-opus-4-8)
# MODEL_SEARCH="claude-opus-4-8"
# MODEL_TAILOR="claude-opus-4-8"
# MODEL_TRIAGE="claude-sonnet-4-6"

# Auth.js
AUTH_SECRET="openssl rand -base64 32"
AUTH_GOOGLE_ID="…apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="…"

# Stripe
STRIPE_SECRET_KEY="sk_live_…"
STRIPE_WEBHOOK_SECRET="whsec_…"
STRIPE_PRICE_ID="price_…"   # monthly subscription price

# Outbound email (Resend)
RESEND_API_KEY="re_…"
EMAIL_FROM="JobPilot <digest@yourdomain.com>"

# Inbound email (Postmark inbound webhook or similar)
INBOUND_DOMAIN="in.yourdomain.com"
INBOUND_WEBHOOK_SECRET="long-random-string"

# App
APP_URL="https://app.yourdomain.com"
CRON_SECRET="long-random-string"
